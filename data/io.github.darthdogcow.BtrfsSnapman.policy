<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>btrfs-snapman</vendor>

  <!-- Read-only listing: no prompt for the active local session. -->
  <action id="io.github.darthdogcow.BtrfsSnapman.query">
    <description>List btrfs subvolumes and snapshots</description>
    <message>Authentication is required to list btrfs snapshots</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/btrfs-snapman/snapman-query</annotate>
  </action>

  <!-- Snapshot / delete / set-ro: admin password, cached for a few minutes. -->
  <action id="io.github.darthdogcow.BtrfsSnapman.admin">
    <description>Create or delete btrfs snapshots</description>
    <message>Authentication is required to change btrfs snapshots</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/btrfs-snapman/snapman-admin</annotate>
  </action>
  <!-- New/remove volume, approve/remove a parent location: admin password every time, never cached. -->
  <action id="io.github.darthdogcow.BtrfsSnapman.manage">
    <description>Create or remove btrfs-snapman volumes and locations</description>
    <message>Authentication is required to create or remove a volume or location</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/btrfs-snapman/snapman-manage</annotate>
  </action>
</policyconfig>
