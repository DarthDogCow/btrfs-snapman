#!/usr/bin/make -f
# No build step: Python scripts and data files, placed by debian/<package>.install.

%:
	dh $@

# The config is the annotated example under its real name; dh_installdeb marks it as a
# conffile. volumes.d and parents.d (in btrfs-snapman-common.dirs) are owned but shipped
# empty: the front ends add one file per volume / approved location, which dpkg never touches.
execute_after_dh_install:
	install -D -m 644 data/config.example.toml \
	        debian/btrfs-snapman-common/etc/btrfs-snapman/config.toml
